{
  "name": "@semanticraft/angular",
  "version": "0.1.0-alpha.1",
  "description": "Angular integration for Semanticraft semantic parsing and content analysis",
  "type": "module",
  "main": "./dist/semanticraft.module.js",
  "module": "./dist/semanticraft.module.js",
  "typings": "./dist/semanticraft.module.d.ts",
  "exports": {
    ".": {
      "import": "./dist/semanticraft.module.js",
      "types": "./dist/semanticraft.module.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@angular/common": "^19.2.16 || ^20.0.0",
    "@angular/core": "^19.2.16 || ^20.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@semanticraft/parser": "workspace:*"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "keywords": [
    "semanticraft",
    "angular",
    "semantic",
    "parsing",
    "content-analysis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aipop-fun/semanticraft",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/aipop-fun/semanticraft/issues"
  },
  "homepage": "https://github.com/aipop-fun/semanticraft#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}